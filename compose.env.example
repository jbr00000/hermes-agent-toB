# Copy to .env.compose for local Docker Desktop use.
# Never commit the real file or reuse these placeholder values.

HERMES_MYSQL_DATABASE=hermes_tob
HERMES_MYSQL_USER=hermes_app
HERMES_MYSQL_PASSWORD=replace-with-a-long-random-password
HERMES_MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
HERMES_MYSQL_PORT=13306

HERMES_REDIS_PASSWORD=replace-with-a-long-random-password
HERMES_REDIS_PORT=16379
HERMES_AGENT_MAX_ATTEMPTS=3

# --- Web 检索组件（docker compose --profile search，见 docs/联网检索接入方案.md）---
# 本地调试端口（仅绑定 127.0.0.1，不对局域网暴露）
SEARXNG_PORT=18080
FIRECRAWL_API_PORT=13002
# Firecrawl 队列组件凭据（只在 hermes-egress 内网使用，不暴露宿主机端口）
FIRECRAWL_POSTGRES_PASSWORD=replace-with-a-long-random-password
FIRECRAWL_RABBITMQ_PASSWORD=replace-with-a-long-random-password
# SearXNG Web UI cookie 签名密钥（启动时注入容器内配置副本，不写入挂载文件）
SEARXNG_SECRET_KEY=replace-with-48-hex-chars

# 注意：hermes 侧的 SEARXNG_URL / FIRECRAWL_API_URL 不属于 compose 变量，
# 应写入 $HERMES_HOME/.env（容器内 /data/.env）：
#   SEARXNG_URL=http://searxng:8080
#   FIRECRAWL_API_URL=http://firecrawl-api:3002
