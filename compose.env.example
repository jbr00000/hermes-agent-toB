# Copy to .env.compose for local Docker Desktop use.
# Never commit the real file or reuse these placeholder values.

HERMES_MYSQL_DATABASE=hermes_tob
HERMES_MYSQL_USER=hermes_app
HERMES_MYSQL_PASSWORD=replace-with-a-long-random-password
HERMES_MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
HERMES_MYSQL_PORT=13306

HERMES_REDIS_PASSWORD=replace-with-a-long-random-password
HERMES_REDIS_PORT=16379
HERMES_AGENT_MAX_ATTEMPTS=3

# --- Web 检索组件（docker compose --profile search，见 docs/联网检索接入方案.md）---
# 本地调试端口（仅绑定 127.0.0.1，不对局域网暴露）
SEARXNG_PORT=18080
FIRECRAWL_API_PORT=13002
# Firecrawl 队列组件凭据（只在 hermes-egress 内网使用，不暴露宿主机端口）
FIRECRAWL_POSTGRES_PASSWORD=replace-with-a-long-random-password
FIRECRAWL_RABBITMQ_PASSWORD=replace-with-a-long-random-password
# SearXNG Web UI cookie 签名密钥（启动时注入容器内配置副本，不写入挂载文件）
SEARXNG_SECRET_KEY=replace-with-48-hex-chars

# 注意：hermes 侧的 SEARXNG_URL / FIRECRAWL_API_URL 不属于 compose 变量，
# 应写入 $HERMES_HOME/.env（容器内 /data/.env）：
#   SEARXNG_URL=http://searxng:8080
#   FIRECRAWL_API_URL=http://firecrawl-api:3002

# --- P3 浏览器兜底（docker compose --profile browser，见 docs/联网检索接入方案.md §9）---
# Chromium CDP 的宿主机调试端口（仅绑定 127.0.0.1；容器内互访走固定 IP 172.31.0.20:9222）
BROWSER_CDP_PORT=19222
# 启用还需在 $HERMES_HOME/config.yaml 配置（非 compose 变量）：
#   features.browser_automation: true
#   browser.cdp_url: http://172.31.0.20:9222   （hermes 跑在 compose 内；dev 用 http://127.0.0.1:19222）
#   browser.allowed_targets: [oa.example.com, .internal.corp, 10.0.1.0/24]   # 内网目标白名单

# --- 知识库构建栈（docker compose --profile knowledge，见 docs/知识库构建方案.md）---
# MinIO 是 Milvus standalone 的内部对象存储（与知识库文档无关），凭据只在
# hermes-data 内网使用，不暴露宿主机端口
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
# 其余知识库配置均不在 compose 变量里：
#   - MinerU / ES / Milvus / embedding 端点 → $HERMES_HOME/deployment.yaml 的 knowledge 段
#     （容器内网地址示例 es_url: http://elasticsearch:19200、milvus_uri: http://milvus:19530）
#   - embedding API key → $HERMES_HOME/.env 的 KNOWLEDGE_EMBEDDING_API_KEY
#     （变量名可由 deployment.yaml 的 knowledge.embedding.api_key_env 改）
#   - 可选 KNOWLEDGE_ES_PASSWORD → $HERMES_HOME/.env（仅当 ES 开启安全层时）
