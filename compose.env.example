# Copy to .env.compose for local Docker Desktop use.
# Never commit the real file or reuse these placeholder values.

HERMES_MYSQL_DATABASE=hermes_tob
HERMES_MYSQL_USER=hermes_app
HERMES_MYSQL_PASSWORD=replace-with-a-long-random-password
HERMES_MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
HERMES_MYSQL_PORT=13306

HERMES_REDIS_PASSWORD=replace-with-a-long-random-password
HERMES_REDIS_PORT=16379
HERMES_AGENT_MAX_ATTEMPTS=3
